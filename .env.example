# HLA Running World V0.3 Roadshow Plus

# Map provider. Use the Web JS API key from AMap / 高德开放平台.
AMAP_KEY=
AMAP_SECURITY_CODE=
# Optional: Web Service key for static share-card map image.
AMAP_STATIC_KEY=

# Domestic AI provider. Options: zhipu, deepseek, qwen, local.
AI_PROVIDER=zhipu
AI_MODEL=glm-4.7-flash

# Choose one provider key. Leave empty to use the local rule fallback.
ZHIPU_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
