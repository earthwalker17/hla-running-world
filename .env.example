# HLA Running World V0.3 Roadshow Plus

# Dynamic map provider. Use the Web JS API key from AMap / 高德开放平台.
AMAP_KEY=
AMAP_SECURITY_CODE=
# Static share-card map image. Use an AMap Web Service key, not the Web JS API key.
AMAP_STATIC_KEY=
# Optional alias if you prefer to name it by key type.
AMAP_WEB_SERVICE_KEY=

# Domestic AI provider. Options: zhipu, deepseek, qwen, local.
AI_PROVIDER=zhipu
AI_MODEL=glm-4.7-flash

# Choose one provider key. Leave empty to use the local rule fallback.
ZHIPU_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
